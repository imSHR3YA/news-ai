{
  "name": "newsai-final",
  "version": "1.0.0",
  "description": "NewsAI — Complete AI-Powered News Blog with Auth, Comments, Ratings",
  "scripts": {
    "dev": "concurrently \"nodemon server/index.js\" \"cd client && npm start\"",
    "server": "nodemon server/index.js",
    "client": "cd client && npm start",
    "install-all": "npm install && cd client && npm install"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "axios": "^1.6.0",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "gsap": "^3.15.0",
    "nodemon": "^3.0.2",
    "rss-parser": "^3.13.0"
  }
}
